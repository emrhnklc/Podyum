{
  "name": "podyum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "setup:backend": "npm --prefix backend ci",
    "setup:mobile": "npm --prefix mobile ci",
    "setup": "npm run setup:backend && npm run setup:mobile",
    "dev:backend": "npm --prefix backend start",
    "dev:mobile": "npm --prefix mobile run dev",
    "build:backend": "npm --prefix backend run build",
    "build:mobile": "npm --prefix mobile run build",
    "build": "npm run build:backend && npm run build:mobile",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:mobile": "npm --prefix mobile run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:mobile",
    "lint:mobile": "npm --prefix mobile run lint",
    "test:api": "npm --prefix backend run test:api",
    "test:db": "npm --prefix backend run test:db",
    "test:smoke": "npm --prefix backend run test:smoke",
    "db:start": "npm --prefix backend run db:start",
    "db:stop": "npm --prefix backend run db:stop",
    "db:status": "npm --prefix backend run db:status",
    "db:generate": "npm --prefix backend run db:generate",
    "db:deploy": "npm --prefix backend run db:deploy",
    "db:check": "npm --prefix backend run db:check",
    "db:studio": "npm --prefix backend run db:studio"
  }
}
