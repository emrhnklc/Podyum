# Telefon için Mac'in aynı Wi-Fi'daki adresini kullan; telefondaki localhost Mac değildir.
# API adresi /v1 dahil olmalıdır. Kayıt/yerel doğrulama ve girişten sonra ana ekran gerçek API kullanır.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/v1

# İsteğe bağlı: public/demo/ altındaki yerel demo fotoğraflarını göstermek için
# Expo geliştirme sunucusunun adresi. Telefon için Mac'in LAN adresi olmalı.
# Tanımlı değilse fotoğraf yerine pastel yer tutucu görünür.
# EXPO_PUBLIC_DEMO_MEDIA_BASE_URL=http://192.168.1.10:8081
