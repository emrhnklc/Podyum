{
  "expo": {
    "name": "Podyum",
    "slug": "podyum",
    "scheme": "podyum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kombin fotoğrafını seçebilmen için galerine erişmemiz gerekiyor.",
          "cameraPermission": "Defile'de kombinini çekebilmen için kameraya erişmemiz gerekiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Podyum"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    }
  }
}
