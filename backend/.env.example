# Yalnızca kombin-proje2 isimli yerel geliştirme sunucusu.
# db:start sabit ve projeye ayrılmış 51221/51222/51223 portlarını kullanır.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51222/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51223/template1?sslmode=disable"
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
API_DOCS_ENABLED="true"
# Gerçek OAuth değildir; yalnızca yerel/test ortamında açılabilir.
AUTH_MOCK_ENABLED="false"
# true: kayıtta doğrulama postası gönderilir ve onaysız hesap giriş yapamaz. Şimdilik kapalı.
AUTH_EMAIL_VERIFICATION_REQUIRED="false"
LOCAL_MAILBOX_DIR=".local/mailbox"
LOCAL_MEDIA_DIR=".local/media"
# API açılışında ve aralıklarla süreli oylamaları kapatır; test ortamında otomatik tarama kapalı.
POLL_CLOSE_WORKER_ENABLED="true"
POLL_CLOSE_INTERVAL_MS="15000"
# Oyun aşamalarını (fotoğraf → oylama → sonuç) ilerletir; test ortamında otomatik tarama kapalı.
GAME_WORKER_ENABLED="true"
GAME_INTERVAL_MS="5000"
# Günlük etkinlik: üçü birlikte verilir. Hiçbiri yoksa günlük etkinlik oluşturulmaz.
# Saat HH:MM, saat dilimi IANA adı, tema etkin bir Theme.slug olmalı. Saat henüz ürün kararı değildir.
# DAILY_GAME_START_TIME="20:00"
# DAILY_GAME_TIME_ZONE="Europe/Istanbul"
# DAILY_GAME_THEME_SLUG="90lar"
# Kalıcı olay kuyruğunu (outbox) işler: uygulama içi bildirim üretir ve push'u teslim eder; test ortamında otomatik tarama kapalı.
OUTBOX_WORKER_ENABLED="true"
OUTBOX_INTERVAL_MS="3000"
# local: push gönderilmez, .local/push altına dosya yazılır. expo: Expo Push servisine gerçek istek atılır.
PUSH_PROVIDER="local"
LOCAL_PUSH_DIR=".local/push"
# Yalnız PUSH_PROVIDER="expo" iken kullanılır. Expo projesinde gelişmiş güvenlik açıksa erişim anahtarı gerekir.
# EXPO_PUSH_URL="https://exp.host/--/api/v2/push/send"
# EXPO_ACCESS_TOKEN=""
# Web istemcisi eklenince tam origin'leri virgülle ayırın. Mobil HTTP için gerekmez.
CORS_ORIGINS=""

# Otomatik bakım saatlik raporlar; gerçek temizlik için MAINTENANCE_APPLY=true.
MAINTENANCE_WORKER_ENABLED="true"
MAINTENANCE_APPLY="false"
MAINTENANCE_INTERVAL_MS="3600000"
MAINTENANCE_BATCH_SIZE="100"
