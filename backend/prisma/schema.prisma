generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthActionKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  UNSPECIFIED
}

enum AgeBand {
  AGE_18_24
  AGE_25_34
  AGE_35_PLUS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum MediaPurpose {
  POLL
  AVATAR
  GAME
}

enum Visibility {
  PUBLIC
  FRIENDS
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum PollCategory {
  OUTFIT
  SHOES
  BAG
  JEWELRY
  ACCESSORY
  TATTOO
}

enum AudienceGender {
  ANY
  WOMEN
  MEN
}

enum GameRoomKind {
  MATCHMAKING
  FRIENDS
}

enum GameRoomStatus {
  WAITING
  PREPARING
  PROCESSING
  VOTING
  CALCULATING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  JOINED
  READY
  WITHDRAWN
  DISQUALIFIED
}

enum GameEntryStatus {
  SUBMITTED
  QUALIFIED
  DISQUALIFIED
}

enum GameRoundStatus {
  PENDING
  OPEN
  CLOSED
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  username           String                @unique @db.VarChar(30)
  displayName        String                @db.VarChar(80)
  bio                String?               @db.VarChar(300)
  status             UserStatus            @default(ACTIVE)
  profileCompletedAt DateTime?             @db.Timestamptz(3)
  socialRevision     Int                   @default(0)
  avatarMediaId      String?               @unique @db.Uuid
  avatar             MediaAsset?           @relation("AvatarMedia", fields: [avatarMediaId], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  identities         AuthIdentity[]
  privateData        UserPrivate?
  settings           UserSettings?
  styles             UserStyle[]
  friendshipsA       Friendship[]          @relation("FriendA")
  friendshipsB       Friendship[]          @relation("FriendB")
  blocksMade         Block[]               @relation("Blocker")
  blocksReceived     Block[]               @relation("Blocked")
  media              MediaAsset[]
  polls              Poll[]
  votes              PollVote[]
  saves              PollSave[]
  comments           Comment[]             @relation("CommentAuthor")
  removedComments    Comment[]             @relation("CommentRemover")
  reportsMade        Report[]              @relation("ReportReporter")
  reportsReceived    Report[]              @relation("ReportTargetUser")
  notifications      Notification[]        @relation("NotificationRecipient")
  notificationsActed Notification[]        @relation("NotificationActor")
  devices            DeviceToken[]
  hostedRooms        GameRoom[]
  participations     GameParticipant[]
  gameMemberships    GameMembership[]
  hostedSessions     GameSession[]
  activeGame         ActiveGameMembership?
  points             PointsLedger[]
  idempotency        IdempotencyRecord[]
  credential         AuthCredential?
  sessions           AuthSession[]
  authActions        AuthActionToken[]
}

model AuthCredential {
  userId          String    @id @db.Uuid
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  version         Int       @default(1)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuthSession {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  provider          String             @db.VarChar(40)
  accessTokenHash   String             @unique @db.Char(64)
  refreshTokenHash  String             @unique @db.Char(64)
  accessExpiresAt   DateTime           @db.Timestamptz(3)
  expiresAt         DateTime           @db.Timestamptz(3)
  revokedAt         DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  usedRefreshTokens UsedRefreshToken[]
  deviceTokens      DeviceToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UsedRefreshToken {
  tokenHash String      @id @db.Char(64)
  sessionId String      @db.Uuid
  expiresAt DateTime    @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([expiresAt])
}

model AuthActionToken {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  kind              AuthActionKind
  tokenHash         String         @unique @db.Char(64)
  credentialVersion Int
  expiresAt         DateTime       @db.Timestamptz(3)
  consumedAt        DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind])
  @@index([expiresAt])
}

model AuthIdentity {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  issuer  String @db.VarChar(255)
  subject String @db.VarChar(255)
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([issuer, subject])
  @@index([userId])
}

model UserPrivate {
  userId             String    @id @db.Uuid
  gender             Gender?
  ageBand            AgeBand?
  cityCode           String?   @db.VarChar(30)
  analyticsConsentAt DateTime? @db.Timestamptz(3)
  analyticsRevision  Int       @default(0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model UserSettings {
  userId                     String     @id @db.Uuid
  pushEnabled                Boolean    @default(true)
  friendRequestNotifications Boolean    @default(true)
  pollResultNotifications    Boolean    @default(true)
  commentNotifications       Boolean    @default(true)
  gameNotifications          Boolean    @default(true)
  defaultPollVisibility      Visibility @default(PUBLIC)
  defaultCommentsEnabled     Boolean    @default(true)
  defaultBlurFace            Boolean    @default(true)
  user                       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model StyleTag {
  id    String      @id @db.VarChar(40)
  label String      @db.VarChar(80)
  users UserStyle[]
}

model UserStyle {
  userId  String   @db.Uuid
  styleId String   @db.VarChar(40)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  style   StyleTag @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@id([userId, styleId])
  @@index([styleId, userId])
}

// A/B UUID sırası SQL CHECK ile kanonik tutulur; requesterId bu çiftin üyesi olmalı.
model Friendship {
  userAId     String           @db.Uuid
  userBId     String           @db.Uuid
  requesterId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  userA       User             @relation("FriendA", fields: [userAId], references: [id], onDelete: Restrict)
  userB       User             @relation("FriendB", fields: [userBId], references: [id], onDelete: Restrict)

  @@id([userAId, userBId])
  @@index([userBId, status])
  @@index([userAId, status])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Restrict)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MediaAsset {
  id                    String           @id @default(uuid()) @db.Uuid
  ownerId               String           @db.Uuid
  status                MediaStatus      @default(PENDING_UPLOAD)
  purpose               MediaPurpose     @default(POLL)
  uploadKey             String           @unique @db.VarChar(500)
  displayKey            String?          @unique @db.VarChar(500)
  thumbnailKey          String?          @unique @db.VarChar(500)
  uploadTokenHash       String?          @db.Char(64)
  uploadExpiresAt       DateTime?        @db.Timestamptz(3)
  declaredMimeType      String?          @db.VarChar(80)
  declaredByteSize      Int?
  rejectionCode         String?          @db.VarChar(80)
  processingRevision    Int              @default(0)
  processingRequestHash String?          @db.Char(64)
  filesPurgedAt         DateTime?        @db.Timestamptz(3)
  sourceVersion         String?          @db.VarChar(255)
  checksum              String?          @db.VarChar(128)
  mimeType              String?          @db.VarChar(80)
  byteSize              Int?
  width                 Int?
  height                Int?
  blurRequested         Boolean          @default(false)
  previewAcceptedAt     DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  owner                 User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  avatarFor             User?            @relation("AvatarMedia")
  pollOptions           PollOption[]
  gameEntries           GameEntry[]
  gameSubmissions       GameSubmission[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model Poll {
  id                 String         @id @default(uuid()) @db.Uuid
  authorId           String         @db.Uuid
  question           String         @db.VarChar(280)
  category           PollCategory
  occasion           String?        @db.VarChar(60)
  visibility         Visibility     @default(PUBLIC)
  audienceGender     AudienceGender @default(ANY)
  audienceAgeBand    AgeBand?
  styleMatchRequired Boolean        @default(false)
  commentsEnabled    Boolean        @default(true)
  status             PollStatus     @default(DRAFT)
  contentStatus      ContentStatus  @default(VISIBLE)
  durationSeconds    Int            @default(1800)
  publishedAt        DateTime?      @db.Timestamptz(3)
  closesAt           DateTime?      @db.Timestamptz(3)
  closedAt           DateTime?      @db.Timestamptz(3)
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  author             User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  options            PollOption[]
  votes              PollVote[]
  saves              PollSave[]
  comments           Comment[]
  reports            Report[]

  @@index([status, visibility, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, closesAt])
}

model PollOption {
  id       String       @id @default(uuid()) @db.Uuid
  pollId   String       @db.Uuid
  position Int
  mediaId  String       @db.Uuid
  poll     Poll         @relation(fields: [pollId], references: [id], onDelete: Restrict)
  media    MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  products ProductTag[]
  votes    PollVote[]

  @@unique([pollId, position])
  @@unique([id, pollId])
  @@index([mediaId])
}

model ProductTag {
  id              String     @id @default(uuid()) @db.Uuid
  optionId        String     @db.Uuid
  title           String     @db.VarChar(150)
  brand           String?    @db.VarChar(100)
  priceMinor      Int?
  currency        String     @default("TRY") @db.Char(3)
  externalUrl     String     @db.VarChar(2048)
  priceRecordedAt DateTime?  @db.Timestamptz(3)
  option          PollOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([optionId])
}

model PollVote {
  pollId                  String          @db.Uuid
  voterId                 String          @db.Uuid
  optionId                String          @db.Uuid
  genderAtVote            Gender?
  ageBandAtVote           AgeBand?
  analyticsConsentAtVote  DateTime?       @db.Timestamptz(3)
  analyticsRevisionAtVote Int?
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  poll                    Poll            @relation(fields: [pollId], references: [id], onDelete: Restrict)
  voter                   User            @relation(fields: [voterId], references: [id], onDelete: Restrict)
  option                  PollOption      @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Restrict)
  reason                  PollVoteReason?

  @@id([pollId, voterId])
  @@index([pollId, optionId])
  @@index([voterId, createdAt(sort: Desc)])
}

model PollSave {
  pollId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([pollId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Comment {
  id            String        @id @default(uuid()) @db.Uuid
  pollId        String        @db.Uuid
  authorId      String        @db.Uuid
  body          String        @db.VarChar(1000)
  contentStatus ContentStatus @default(VISIBLE)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  removedAt     DateTime?     @db.Timestamptz(3)
  removedById   String?       @db.Uuid
  poll          Poll          @relation(fields: [pollId], references: [id], onDelete: Restrict)
  author        User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  removedBy     User?         @relation("CommentRemover", fields: [removedById], references: [id], onDelete: Restrict)
  reports       Report[]

  @@index([pollId, createdAt, id])
  @@index([authorId])
}

enum PollReasonCode {
  COLOR_HARMONY
  MORE_STYLISH
  MORE_COMFORTABLE
  FITS_OCCASION
  BETTER_FIT
}

// Oy verenin kendi seçtiği seçenek için işaretlediği tek hazır neden.
// Seçenek ayrı tutulmaz; değişmez PollVote kaydından okunur.
model PollVoteReason {
  pollId    String         @db.Uuid
  voterId   String         @db.Uuid
  reason    PollReasonCode
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  vote      PollVote       @relation(fields: [pollId, voterId], references: [pollId, voterId], onDelete: Restrict)

  @@id([pollId, voterId])
  @@index([pollId, reason])
}

enum ReportTargetType {
  POLL
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Hedef türüne göre tam bir hedef sütunu doludur (migration'da CHECK).
model Report {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String           @db.Uuid
  targetType   ReportTargetType
  pollId       String?          @db.Uuid
  commentId    String?          @db.Uuid
  targetUserId String?          @db.Uuid
  reason       ReportReason
  note         String?          @db.VarChar(500)
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  poll         Poll?            @relation(fields: [pollId], references: [id], onDelete: Restrict)
  comment      Comment?         @relation(fields: [commentId], references: [id], onDelete: Restrict)
  targetUser   User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@unique([reporterId, pollId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, targetUserId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt(sort: Desc)])
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  eventId      String    @db.Uuid
  type         String    @db.VarChar(80)
  resourceType String    @db.VarChar(40)
  resourceId   String    @db.Uuid
  actorId      String?   @db.Uuid
  count        Int       @default(1)
  readAt       DateTime? @db.Timestamptz(3)
  activityAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  user         User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  actor        User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([userId, eventId, type])
  @@index([userId, activityAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@index([userId, type, resourceId])
  @@index([actorId])
}

model DeviceToken {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  installationId String      @unique @db.Uuid
  sessionId      String      @db.Uuid
  token          String      @unique @db.VarChar(512)
  platform       String      @db.VarChar(20)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  session        AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([sessionId])
}

model Theme {
  id       String        @id @default(uuid()) @db.Uuid
  slug     String        @unique @db.VarChar(80)
  title    String        @db.VarChar(120)
  active   Boolean       @default(true)
  rooms    GameRoom[]
  sessions GameSession[]
}

model GameRoom {
  id                 String            @id @default(uuid()) @db.Uuid
  hostId             String?           @db.Uuid
  themeId            String?           @db.Uuid
  kind               GameRoomKind
  status             GameRoomStatus    @default(WAITING)
  inviteCodeHash     String?           @unique @db.VarChar(128)
  maxPlayers         Int               @default(8)
  minPlayers         Int               @default(3)
  preparationSeconds Int               @default(600)
  roundSeconds       Int               @default(20)
  processingSeconds  Int               @default(30)
  rulesVersion       String            @default("alpha-v1") @db.VarChar(40)
  rulesSnapshot      Json
  version            Int               @default(0)
  phaseEndsAt        DateTime?         @db.Timestamptz(3)
  currentRoundIndex  Int?
  qualifiedCount     Int               @default(0)
  startedAt          DateTime?         @db.Timestamptz(3)
  finishedAt         DateTime?         @db.Timestamptz(3)
  cancelReason       String?           @db.VarChar(80)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  host               User?             @relation(fields: [hostId], references: [id], onDelete: Restrict)
  theme              Theme?            @relation(fields: [themeId], references: [id], onDelete: Restrict)
  participants       GameParticipant[]
  entries            GameEntry[]
  rounds             GameRound[]
  results            GameResult[]
  points             PointsLedger[]

  @@index([status, phaseEndsAt])
  @@index([kind, status, createdAt])
  @@index([hostId])
}

model GameParticipant {
  roomId           String                @db.Uuid
  userId           String                @db.Uuid
  status           ParticipantStatus     @default(JOINED)
  qualified        Boolean               @default(false)
  joinedAt         DateTime              @default(now()) @db.Timestamptz(3)
  room             GameRoom              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  entry            GameEntry?
  ratings          GameRating[]
  activeMembership ActiveGameMembership?

  @@id([roomId, userId])
  @@index([userId, joinedAt(sort: Desc)])
}

// Kullanıcı aynı anda tek aktif oyunda: bitiş/iptal işlemi bu kaydı transaction içinde kaldırır.
model ActiveGameMembership {
  userId      String          @id @db.Uuid
  roomId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  participant GameParticipant @relation(fields: [roomId, userId], references: [roomId, userId], onDelete: Restrict)

  @@unique([roomId, userId])
  @@index([roomId])
}

model GameEntry {
  id          String          @id @default(uuid()) @db.Uuid
  roomId      String          @db.Uuid
  userId      String          @db.Uuid
  mediaId     String          @db.Uuid
  status      GameEntryStatus @default(SUBMITTED)
  submittedAt DateTime        @default(now()) @db.Timestamptz(3)
  room        GameRoom        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participant GameParticipant @relation(fields: [roomId, userId], references: [roomId, userId], onDelete: Restrict)
  media       MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  round       GameRound?
  result      GameResult?

  @@unique([roomId, userId])
  @@unique([id, roomId, userId])
  @@index([mediaId])
}

model GameRound {
  id           String          @id @default(uuid()) @db.Uuid
  roomId       String          @db.Uuid
  entryId      String          @unique @db.Uuid
  targetUserId String          @db.Uuid
  position     Int
  status       GameRoundStatus @default(PENDING)
  opensAt      DateTime?       @db.Timestamptz(3)
  closesAt     DateTime?       @db.Timestamptz(3)
  room         GameRoom        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  entry        GameEntry       @relation(fields: [entryId, roomId, targetUserId], references: [id, roomId, userId], onDelete: Restrict)
  ratings      GameRating[]

  @@unique([roomId, position])
  @@unique([entryId, roomId, targetUserId])
  @@unique([id, roomId, targetUserId])
}

model GameRating {
  roundId      String          @db.Uuid
  roomId       String          @db.Uuid
  voterId      String          @db.Uuid
  targetUserId String          @db.Uuid
  stars        Int
  themeFits    Boolean
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  round        GameRound       @relation(fields: [roundId, roomId, targetUserId], references: [id, roomId, targetUserId], onDelete: Restrict)
  voter        GameParticipant @relation(fields: [roomId, voterId], references: [roomId, userId], onDelete: Restrict)

  @@id([roundId, voterId])
  @@index([roomId])
}

model GameResult {
  roomId        String    @db.Uuid
  entryId       String    @unique @db.Uuid
  userId        String    @db.Uuid
  rank          Int?
  ratingCount   Int
  ratingSum     Int
  themeYesCount Int
  quorumMet     Boolean
  official      Boolean   @default(false)
  computedAt    DateTime  @default(now()) @db.Timestamptz(3)
  room          GameRoom  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  entry         GameEntry @relation(fields: [entryId, roomId, userId], references: [id, roomId, userId], onDelete: Restrict)

  @@id([roomId, userId])
  @@unique([entryId, roomId, userId])
}

model PointsLedger {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  roomId        String   @db.Uuid
  sourceKind    String   @db.VarChar(40)
  sourceId      String   @db.Uuid
  awardCode     String   @db.VarChar(40)
  policyVersion String   @db.VarChar(40)
  delta         Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  room          GameRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceKind, sourceId, awardCode])
  @@index([userId, createdAt(sort: Desc)])
  @@index([roomId])
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  aggregateType    String    @db.VarChar(40)
  aggregateId      String    @db.Uuid
  aggregateVersion Int
  type             String    @db.VarChar(100)
  payload          Json
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @db.Timestamptz(3)
  leaseUntil       DateTime? @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, availableAt, leaseUntil])
  @@index([aggregateType, aggregateId, aggregateVersion])
}

model IdempotencyRecord {
  userId       String   @db.Uuid
  scope        String   @db.VarChar(150)
  key          String   @db.VarChar(100)
  requestHash  String   @db.Char(64)
  responseCode Int
  responseBody Json
  expiresAt    DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, scope, key])
  @@index([expiresAt])
}

// Günlük 30+30 ve özel QR lobileri. Eski tur tabloları yerel veri için korunur.
enum GameSessionKind {
  DAILY
  PRIVATE
}

enum GamePhase {
  SCHEDULED
  WAITING
  SUBMISSION
  VOTING
  COMPLETED
  CANCELLED
}

enum GameMemberStatus {
  ACTIVE
  LEFT
}

enum GameSubmissionStatus {
  SUBMITTED
  FROZEN
  WITHDRAWN
}

model GameSession {
  id                String           @id @default(uuid()) @db.Uuid
  kind              GameSessionKind
  phase             GamePhase
  hostId            String?          @db.Uuid
  themeId           String?          @db.Uuid
  themeTitle        String           @db.VarChar(120)
  dailyKey          String?          @unique @db.VarChar(10)
  scheduleTimeZone  String?          @db.VarChar(80)
  scheduleStartTime String?          @db.VarChar(5)
  rulesVersion      String           @default("podyum-v1") @db.VarChar(40)
  submissionSeconds Int              @default(1800)
  votingSeconds     Int              @default(1800)
  maxMembers        Int?
  version           Int              @default(0)
  ballotSlots       Int              @default(0)
  waitingExpiresAt  DateTime?        @db.Timestamptz(3)
  startsAt          DateTime?        @db.Timestamptz(3)
  submissionEndsAt  DateTime?        @db.Timestamptz(3)
  votingStartsAt    DateTime?        @db.Timestamptz(3)
  votingEndsAt      DateTime?        @db.Timestamptz(3)
  finishedAt        DateTime?        @db.Timestamptz(3)
  cancelReason      String?          @db.VarChar(80)
  inviteHash        String?          @unique @db.Char(64)
  inviteExpiresAt   DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  host              User?            @relation(fields: [hostId], references: [id], onDelete: Restrict)
  theme             Theme?           @relation(fields: [themeId], references: [id], onDelete: Restrict)
  members           GameMembership[]
  submissions       GameSubmission[]
  outcomes          GameOutcome[]

  @@index([phase, submissionEndsAt])
  @@index([phase, votingEndsAt])
  @@index([phase, startsAt])
  @@index([phase, waitingExpiresAt])
  @@index([hostId, createdAt(sort: Desc)])
}

model GameMembership {
  sessionId  String           @db.Uuid
  userId     String           @db.Uuid
  status     GameMemberStatus @default(ACTIVE)
  ballotSeed Int
  joinedAt   DateTime         @default(now()) @db.Timestamptz(3)
  leftAt     DateTime?        @db.Timestamptz(3)
  session    GameSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  submission GameSubmission?
  ratings    GameScore[]

  @@id([sessionId, userId])
  @@index([userId, joinedAt(sort: Desc), sessionId(sort: Desc)])
}

model GameSubmission {
  id          String               @id @default(uuid()) @db.Uuid
  sessionId   String               @db.Uuid
  userId      String               @db.Uuid
  mediaId     String               @db.Uuid
  position    Int
  status      GameSubmissionStatus @default(SUBMITTED)
  submittedAt DateTime             @default(now()) @db.Timestamptz(3)
  session     GameSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  member      GameMembership       @relation(fields: [sessionId, userId], references: [sessionId, userId], onDelete: Restrict)
  media       MediaAsset           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  scores      GameScore[]
  outcome     GameOutcome?

  @@unique([sessionId, userId])
  @@unique([sessionId, position])
  @@unique([id, sessionId, userId])
  @@index([mediaId])
}

model GameScore {
  submissionId String         @db.Uuid
  sessionId    String         @db.Uuid
  targetUserId String         @db.Uuid
  voterId      String         @db.Uuid
  stars        Int
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  submission   GameSubmission @relation(fields: [submissionId, sessionId, targetUserId], references: [id, sessionId, userId], onDelete: Restrict)
  voter        GameMembership @relation(fields: [sessionId, voterId], references: [sessionId, userId], onDelete: Restrict)

  @@id([submissionId, voterId])
  @@index([sessionId])
}

model GameOutcome {
  sessionId    String         @db.Uuid
  submissionId String         @unique @db.Uuid
  userId       String         @db.Uuid
  ratingCount  Int
  ratingSum    Int
  computedAt   DateTime       @default(now()) @db.Timestamptz(3)
  session      GameSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  submission   GameSubmission @relation(fields: [submissionId, sessionId, userId], references: [id, sessionId, userId], onDelete: Restrict)

  @@id([sessionId, userId])
  @@unique([submissionId, sessionId, userId])
}
