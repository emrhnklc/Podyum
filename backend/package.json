{
  "name": "podyum-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "pretest:smoke": "npm run build",
    "test:smoke": "tsx scripts/smoke-api.ts",
    "pretest:api": "npm run build",
    "test:api": "tsx --test --test-concurrency=1 tests/api.test.ts tests/users.test.ts tests/social.test.ts tests/media.test.ts tests/polls.test.ts tests/poll-votes.test.ts tests/feed.test.ts tests/poll-interactions.test.ts tests/notifications.test.ts tests/games.test.ts tests/game-realtime.test.ts tests/moderation.test.ts tests/accounts.test.ts tests/technical-retention.test.ts tests/catalog.test.ts tests/game-management.test.ts tests/maintenance.test.ts tests/poll-catalog.test.ts tests/trends.test.ts tests/trends-api.test.ts",
    "pretest:votes": "npm run build",
    "test:votes": "tsx --test --test-concurrency=1 tests/poll-votes.test.ts",
    "prepolls:close": "npm run build",
    "polls:close": "tsx scripts/close-polls.ts",
    "pretest:polls": "npm run build",
    "test:polls": "tsx --test --test-concurrency=1 tests/polls.test.ts",
    "pretest:media": "npm run build",
    "test:media": "tsx --test --test-concurrency=1 tests/media.test.ts",
    "premedia:cleanup": "npm run build",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "pretest:social": "npm run build",
    "test:social": "tsx --test --test-concurrency=1 tests/social.test.ts",
    "pretest:users": "npm run build",
    "test:users": "tsx --test --test-concurrency=1 tests/users.test.ts",
    "db:start": "prisma dev --name kombin-proje2 --port 51221 --db-port 51222 --shadow-db-port 51223 --detach",
    "db:stop": "prisma dev stop kombin-proje2",
    "db:status": "prisma dev ls",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts dev",
    "db:deploy": "tsx scripts/migrate.ts deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx --test --test-concurrency=1 tests/database.test.ts",
    "pretest:feed": "npm run build",
    "test:feed": "tsx --test --test-concurrency=1 tests/feed.test.ts",
    "pretest:games": "npm run build",
    "test:games": "tsx --test --test-concurrency=1 tests/games.test.ts tests/game-management.test.ts",
    "pretest:interactions": "npm run build",
    "test:interactions": "tsx --test --test-concurrency=1 tests/poll-interactions.test.ts",
    "pretest:notifications": "npm run build",
    "test:notifications": "tsx --test --test-concurrency=1 tests/notifications.test.ts",
    "pretest:realtime": "npm run build",
    "test:realtime": "tsx --test --test-concurrency=1 tests/game-realtime.test.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "pretest:moderation": "npm run build",
    "test:moderation": "tsx --test --test-concurrency=1 tests/moderation.test.ts",
    "pretest:accounts": "npm run build",
    "test:accounts": "tsx --test --test-concurrency=1 tests/accounts.test.ts",
    "preaccounts:cleanup": "npm run build",
    "accounts:cleanup": "tsx scripts/cleanup-accounts.ts",
    "preview:mobile": "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1 tsx scripts/preview-mobile-home.ts",
    "demo:try-on": "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1 tsx scripts/demo-try-on.ts",
    "maintenance:technical": "tsx scripts/cleanup-technical.ts",
    "test:retention": "tsx --test --test-concurrency=1 tests/technical-retention.test.ts",
    "premaintenance:run": "npm run build",
    "maintenance:run": "tsx scripts/cleanup-maintenance.ts",
    "pretest:catalog": "npm run build",
    "test:catalog": "tsx --test --test-concurrency=1 tests/catalog.test.ts",
    "pretest:maintenance": "npm run build",
    "test:maintenance": "tsx --test --test-concurrency=1 tests/technical-retention.test.ts tests/maintenance.test.ts",
    "pretest:poll-catalog": "npm run build",
    "test:poll-catalog": "tsx --test --test-concurrency=1 tests/poll-catalog.test.ts",
    "trends:rebuild": "tsx scripts/rebuild-trends.ts",
    "pretest:trends": "npm run build",
    "test:trends": "tsx --test --test-concurrency=1 tests/trends.test.ts tests/trends-api.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
